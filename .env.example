# YouCam API key from https://yce.perfectcorp.com/api-console/en/api-keys/
YOUCAM_API_KEY=

# OpenRouter key for the trial assistant (optional; the panel hides without it)
OPENROUTER_API_KEY=
# Optional: model and per-IP question limit for the assistant
COACH_MODEL=google/gemini-3.8-flash
COACH_QUESTIONS_PER_IP_PER_DAY=10

# Spending guards for a public demo
DAILY_UNIT_CAP=150
SCANS_PER_IP_PER_DAY=6
# Units one IP may spend per day across analysis, simulation and aging
UNITS_PER_IP_PER_DAY=70
UNIT_RESERVE=60
# Comma-separated IPs that skip the per-IP limit (your own testing)
DEMO_UNLIMITED_IPS=

# Public origin, sent to OpenRouter as HTTP-Referer
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shown in the footer
NEXT_PUBLIC_REPO_URL=https://github.com/DarinaX2005X/KEPT-youcam-hackathon
